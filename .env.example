# ---- Server ----
PORT=5000
NODE_ENV=production
BASE_URL=https://recello.in

# ---- Database ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Existing app auth ----
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-too-min-32-chars
JWT_EXPIRES_IN=3h
REFRESH_EXPIRES_DAYS=30

# ---- SMS (Dove) -- the website's 4-digit OTP reuses the same sender/template ----
DOVE_API_KEY=
DOVE_ENTITY_ID=
DOVE_SENDER_ID=
DOVE_TEMPLATE_ID=

# ---- NEW: website / mobile page (/api/web) ----
# Signs the 30-day login tokens and hashes OTPs. Set a long random value (>=16 chars).
# If unset it falls back to TRACK_SECRET, then JWT_ACCESS_SECRET.
WEB_SECRET=
# Price shown only after phone OTP (1 = on, default). 0 shows prices straight away.
WEB_PRICE_GATE=1
# Proof-of-work robot check before an OTP is sent (1 = on, default).
WEB_BOT_CHECK=1
WEB_BOT_CHECK_BITS=16
# Play Store review login: this phone always gets this 4-digit code (leave empty in normal use)
GPLAY_STATIC_PHONE=
GPLAY_STATIC_OTP=
# LOCAL TESTING ONLY. Skips the SMS and returns the code in the API reply. Never set in production
# (it is ignored when NODE_ENV=production).
# SMS_DRY_RUN=1
