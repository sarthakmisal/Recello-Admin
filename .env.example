# Copy to .env and fill in. Never commit .env. Names are the ones the code reads.
NODE_ENV=production
PORT=5500
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random
JWT_EXPIRES_IN=3h
REFRESH_EXPIRES_DAYS=15

# SMS (Dove) for the login OTP
DOVE_API_KEY=
DOVE_SENDER_ID=
DOVE_ENTITY_ID=
DOVE_TEMPLATE_ID=

EMAIL=
EMAIL_PASSWORD=
BASE_URL=
SYSTEM_PASSWORD=

# Play Store reviewer login: this phone accepts any OTP. Leave empty if you do not need it.
GPLAY_STATIC_PHONE=

# NEW (optional). Only for the Android app, whose page runs on https://localhost and calls this server cross-site:
# set to none so the refresh cookie is sent (it is then also marked Secure, so the API must be on https).
# Leave unset for the website on the same site as the API.
COOKIE_SAMESITE=
